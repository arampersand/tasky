{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "python3 ~/.tasky/tasky_agent.py hook working" }] }
    ],
    "Notification": [
      { "hooks": [{ "type": "command", "command": "python3 ~/.tasky/tasky_agent.py hook waiting" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "python3 ~/.tasky/tasky_agent.py hook done" }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "python3 ~/.tasky/tasky_agent.py hook end" }] }
    ],
    "PermissionRequest": [
      { "hooks": [{ "type": "command", "command": "python3 ~/.tasky/tasky_agent.py ask", "timeout": 90 }] }
    ]
  }
}
